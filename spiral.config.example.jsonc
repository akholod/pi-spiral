// Spiral configuration.
// Locations (project overrides user, key by key):
//   user:    ~/.pi/agent/spiral.json
//   project: .pi/spiral.json
// The loader accepts JSONC (comments and trailing commas).
//
// Built-in defaults use "inherit" for every role: children run on the model
// selected in the pi session that issues /ralplan. That works on any install
// but gives the critic no independent viewpoint. The profile below is the
// recommended setup when the providers are available: Opus for planner and
// architect (pi-claude-bridge), GPT-5.6 Sol for the critic (openai-codex).
{
  "ralplan": {
    // Planner -> architect -> critic rounds. Hard cap 5 (OMC reference);
    // higher values invalidate the file.
    "maxIterations": 5,

    // Where plan artifacts are written, relative to the project cwd.
    "plansDir": ".spiral/plans",

    // "auto" enables deliberate mode (pre-mortem + expanded test plan) when the
    // task text signals high risk (auth/security, migrations, destructive
    // changes, production, compliance/PII, breaking API changes).
    // "always" / "never" force it.
    "deliberate": "auto",

    // Per-role model settings. `model` is "inherit" or a fully qualified pi
    // model id (provider/model). `thinking` is one of
    // off | minimal | low | medium | high | xhigh | max.
    "roles": {
      "planner": {
        "model": "claude-bridge/claude-opus-5",
        "thinking": "high",
        "timeoutMs": 900000
      },
      "architect": {
        "model": "claude-bridge/claude-opus-5",
        "thinking": "high",
        "timeoutMs": 600000
      },
      "critic": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "timeoutMs": 600000
      }
    }
  },

  "ralph": {
    // Story attempts. Review rounds have their own budget below.
    "maxIterations": 20,

    // Run state root, OUTSIDE the project ("~/..." or absolute):
    // <stateDir>/<project>/<runId>/{prd.json, run.json, progress.md, integrity.json}
    "stateDir": "~/.pi/agent/spiral/ralph",

    // Post-review ai-slop-cleaner pass on the changed files (OMC step 7.5).
    // `/ralph --no-deslop` skips it for one run.
    "deslop": true,

    // Which read-only agent verifies the finished PRD: critic | architect.
    "reviewerAgent": "critic",

    // Reviewer rounds before the run ends as `exhausted`.
    "maxReviewAttempts": 3,

    // Regression commands the loop itself runs after every story, before
    // the review and after cleanup. Empty = the PRD planner may propose
    // commands, which /ralph asks you to confirm (the tool never runs
    // them). Set explicitly to run without asking.
    "verify": ["npm test", "npm run typecheck"],
    "verifyTimeoutMs": 600000,

    // prd: drafts prd.json (planner agent, read-only).
    // executor / cleaner: writers with pi's normal tools including a shell.
    // reviewer: read-only critic or architect; a different provider than
    // the executor gives an independent second opinion.
    "roles": {
      "prd": { "model": "claude-bridge/claude-opus-5", "thinking": "high" },
      "executor": { "model": "claude-bridge/claude-opus-5", "thinking": "medium" },
      "reviewer": { "model": "openai-codex/gpt-6-sol", "thinking": "high" },
      "cleaner": { "model": "claude-bridge/claude-opus-5", "thinking": "medium" }
    }
  }
}
