// Spiral configuration.
// Locations (project overrides user, key by key):
//   user:    ~/.pi/agent/spiral.json
//   project: .pi/spiral.json
// The loader accepts JSONC (comments and trailing commas).
//
// Built-in defaults use "inherit" for every role: children run on the model
// selected in the pi session that issues /ralplan. That works on any install
// but gives the critic no independent viewpoint. The profile below is the
// recommended setup when the providers are available: Opus for planner and
// architect (pi-claude-bridge), GPT-5.6 Sol for the critic (openai-codex).
{
  "ralplan": {
    // Planner -> architect -> critic rounds. Hard cap 5 (OMC reference);
    // higher values invalidate the file.
    "maxIterations": 5,

    // Where plan artifacts are written, relative to the project cwd.
    "plansDir": ".spiral/plans",

    // "auto" enables deliberate mode (pre-mortem + expanded test plan) when the
    // task text signals high risk (auth/security, migrations, destructive
    // changes, production, compliance/PII, breaking API changes).
    // "always" / "never" force it.
    "deliberate": "auto",

    // Per-role model settings. `model` is "inherit" or a fully qualified pi
    // model id (provider/model). `thinking` is one of
    // off | minimal | low | medium | high | xhigh | max.
    "roles": {
      "planner": {
        "model": "claude-bridge/claude-opus-5",
        "thinking": "high",
        "timeoutMs": 900000
      },
      "architect": {
        "model": "claude-bridge/claude-opus-5",
        "thinking": "high",
        "timeoutMs": 600000
      },
      "critic": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "timeoutMs": 600000
      }
    }
  },

  "ralph": {
    // Phase 2. Kept here so the config shape is stable from day one.
    "maxIterations": 20,
    "stateDir": ".spiral/ralph",
    "roles": {
      "executor": { "model": "inherit", "thinking": "medium" },
      "reviewer": { "model": "claude-bridge/claude-opus-5", "thinking": "high" }
    }
  }
}
