// Spiral settings. Copy what you need, not the whole file.
//   ~/.pi/agent/spiral.json  yours, for every project
//   .pi/spiral.json          per project, overrides yours key by key
// Comments and trailing commas are fine. Run /spiral-config to check.
//
// Without this file every role uses your current pi model. The profile below
// puts reviewers on a different provider than authors, so they don't just
// agree with them.
{
  // A permission prompt from a child agent: "forward" shows it to you,
  // "deny" refuses it (for unattended runs).
  "permissionAsks": "forward",

  // Preset used when you don't pick one. "default" = no preset.
  "defaultPreset": "default",

  // Presets override roles and loop limits. Built in: lite and deep (thinking
  // and limits only); define one with the same name to replace it.
  "presets": {
    "deep": {
      "ralplan": {
        "deliberate": "always",
        "roles": {
          "planner": {
            "model": "claude-bridge/claude-opus-5-5",
            "thinking": "high",
          },
          "critic": { "model": "openai-codex/gpt-6-sol", "thinking": "xhigh" },
        },
      },
      "ralph": {
        "roles": {
          "executor": {
            "model": "claude-bridge/claude-opus-5-5",
            "thinking": "high",
          },
          "reviewer": {
            "model": "openai-codex/gpt-6-sol",
            "thinking": "xhigh",
          },
        },
      },
    },
    "lite": {
      "ralplan": {
        "deliberate": "never",
        "maxIterations": 3,
        "roles": {
          "planner": {
            "model": "claude-bridge/claude-sonnet-5-5",
            "thinking": "low",
          },
          "critic": {
            "model": "openai-codex/gpt-6-luna",
            "thinking": "medium",
          },
        },
      },
      "ralph": {
        "maxReviewAttempts": 2,
        "roles": {
          "executor": {
            "model": "claude-bridge/claude-sonnet-5-5",
            "thinking": "high",
          },
          "reviewer": {
            "model": "openai-codex/gpt-6-luna",
            "thinking": "medium",
          },
        },
      },
    },
  },

  "ralplan": {
    // Review rounds, at most 5.
    "maxIterations": 5,
    "plansDir": ".spiral/plans",
    // "auto" adds a pre-mortem and a wider test plan when the task sounds
    // risky (auth, migrations, data loss, breaking APIs). "always" / "never".
    "deliberate": "auto",

    // model: "inherit" or provider/model. thinking: off | minimal | low |
    // medium | high | xhigh | max.
    "roles": {
      "planner": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "medium",
        "timeoutMs": 900000,
      },
      "architect": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "medium",
        "timeoutMs": 600000,
      },
      "critic": {
        "model": "openai-codex/gpt-6-sol",
        "thinking": "high",
        "timeoutMs": 600000,
      },
    },
  },

  "ralph": {
    // Story attempts in one run.
    "maxIterations": 20,
    // Where run state lives, outside the project. Default:
    // ~/.pi/agent/spiral/ralph (follows PI_CODING_AGENT_DIR).
    // "stateDir": "~/.pi/agent/spiral/ralph",

    // Cleanup pass over the changed files after review.
    "deslop": true,
    // Who checks the finished work: critic | architect.
    "reviewerAgent": "critic",
    // Review rounds before ralph gives up.
    "maxReviewAttempts": 3,

    // Commands ralph runs after every story. Unset: ralph proposes them and
    // asks you first. Best set per project in .pi/spiral.json.
    // "verify": ["npm test", "npm run typecheck"],
    "verifyTimeoutMs": 600000,

    // Stop at 90% of this many tokens (resumable). 0 = no limit.
    "budgetTokens": 0,

    // prd writes the stories, executor and cleaner edit code, reviewer
    // checks the result read-only.
    "roles": {
      "prd": { "model": "claude-bridge/claude-opus-5-5", "thinking": "high" },
      "executor": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "medium",
      },
      "reviewer": { "model": "openai-codex/gpt-6-sol", "thinking": "high" },
      "cleaner": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "low",
      },
    },
  },
}
